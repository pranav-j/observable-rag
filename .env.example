# Which provider answers questions. openai | gemini | groq
LLM_PROVIDER=openai

# Keys for whichever providers you use. Only the active one is required, but a
# second one is worth having: the judge picks a provider the generator isn't
# using (see below).
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides; each provider has a sensible default.
# OPENAI_MODEL=
# GEMINI_MODEL=
# GROQ_MODEL=

# The eval judge. Left unset, it picks any provider you have a key for that the
# generator isn't using, so it isn't grading its own output. If no second
# provider is available it falls back to the generator's model and the eval
# report records independent_judge: false.
# JUDGE_PROVIDER=
# JUDGE_MODEL=

# The docs revision the index is built from. Defaults to master, which MOVES --
# set a tag or commit sha to keep chunk ids and the golden set reproducible.
# FASTAPI_REF=

QDRANT_URL=http://localhost:6333
