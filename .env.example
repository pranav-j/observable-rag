# --- the only thing you actually need -------------------------------------
OPENAI_API_KEY=

# Everything below is optional. With just the key above you get a working
# generator and a working eval judge on a second model.

# --- switching provider ----------------------------------------------------
# openai (default) | gemini | groq. All three speak the OpenAI API format, so
# switching is config, not code.
# LLM_PROVIDER=openai

# Model overrides. Each provider has a default; set these to pin a model.
# OPENAI_MODEL=gpt-5-nano
# GEMINI_MODEL=
# GROQ_MODEL=

# Keys for the other providers, only if you switch to them.
# GEMINI_API_KEY=
# GROQ_API_KEY=

# --- the eval judge --------------------------------------------------------
# Grades faithfulness and citations during eval. It has to be a DIFFERENT model
# from the generator or it grades its own work generously, so by default it
# picks a second model on whichever provider you're already using -- no extra
# key, no extra billing. Set these to override.
#
# Heads up if you point it at a free tier: Gemini's is 20 requests/day and
# Groq's is 200k tokens/day, and one eval run needs ~190 judge calls. The run
# will report judge_coverage below 1.0 and null the metric rather than average
# whatever got through.
# JUDGE_PROVIDER=
# JUDGE_MODEL=

# --- corpus ----------------------------------------------------------------
# The docs revision the index is built from. Defaults to master, which MOVES --
# set a tag or commit sha to keep chunk ids and the golden set reproducible.
# FASTAPI_REF=

QDRANT_URL=http://localhost:6333
